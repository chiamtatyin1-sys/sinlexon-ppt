  <script>
      (function () {
          if (window.__instantNavInitialized) {
              return;
          }
          window.__instantNavInitialized = true;

          function stopAllImages() {
              try {
                  var images = document.querySelectorAll("img");
                  var stoppedCount = 0;
                  images.forEach(function (img) {
                      if (img.src && !img.dataset.stopped) {
                          img.dataset.stopped = "1";
                          img.dataset.originalSrc = img.src;
                          img.removeAttribute("src");
                          img.removeAttribute("srcset");
                          stoppedCount++;
                      }
                  });

              } catch (e) {

              }
          }

          function handleClick(e) {
              try {
                  var a = e.target.closest("a[data-instant=\"1\"]");
                  if (!a) {
                      return;
                  }

                  if (a.getAttribute("target") === "_blank" || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) {
                      return;
                  }

                  var href = a.getAttribute("href");
                  if (!href || href.startsWith("#") || href.startsWith("javascript:")) {
                      return;
                  }

                  try {
                      var url = new URL(href, window.location.origin);
                      if (url.origin !== window.location.origin) {
                          return;
                      }

                      e.preventDefault();
                      e.stopPropagation();
                      e.stopImmediatePropagation();

                      window.__isNavigating = true;
                      stopAllImages();

                      try {
                          window.stop();
                      } catch (stopError) {
                      }

                      setTimeout(function () {
                          window.location.replace(href);
                      }, 0);
                  } catch (e) {
                      window.location.href = href;
                  }
              } catch (err) {
              }
          }

          document.addEventListener("click", handleClick, true);

          if (document.readyState === "loading") {
              document.addEventListener("DOMContentLoaded", function () {
                  document.addEventListener("click", handleClick, true);
              }, {once: true});
          }

          if (document.readyState !== "complete") {
              window.addEventListener("load", function () {
                  document.addEventListener("click", handleClick, true);
              }, {once: true});
          }
      })();
  </script>
